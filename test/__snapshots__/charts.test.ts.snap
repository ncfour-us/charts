exports[`PieChart tests Pie Chart, two sets of values, HTML 1`] = `
"
    <div style="height: 60vh; width: 80vw; margin: auto; background-color: rgba(0,0,0,0)">
      <canvas id="myScatterChart123">

      <script>
        // 1. Get the drawing context from the canvas element
        // const ctx2 = document.getElementById('myScatterChart123').getContext('2d');
        const ctx2 = document.currentScript.parentElement.getContext('2d');
    
        // 2. Set chart properties
        const chartProperties = {
  "type": "doughnut",
  "data": {
    "labels": [
      "slice 0:1",
      "slice 0:2",
      "slice 0:3",
      "slice 0:4",
      "slice 1:1",
      "slice 1:2",
      "slice 1:3",
      "slice 1:4"
    ],
    "datasets": [
      {
        "data": [
          2,
          3,
          4,
          5
        ],
        "label": "first-set",
        "backgroundColor": [
          "rgba(0, 0, 0, 1)",
          "rgba(63, 63, 63, 1)",
          "rgba(127, 127, 127, 1)",
          "rgba(191, 191, 191, 1)"
        ]
      },
      {
        "data": [
          2,
          3,
          4,
          5
        ],
        "label": "dataset 2",
        "backgroundColor": [
          "rgba(0, 0, 0, 1)",
          "rgba(63, 63, 63, 1)",
          "rgba(127, 127, 127, 1)",
          "rgba(191, 191, 191, 1)"
        ]
      }
    ]
  },
  "options": {
    "cutout": "0%",
    "plugins": {
      "title": {
        "display": true,
        "text": "Chart Title"
      },
      "legend": {
        "display": true,
        "labels": {
          "generateLabels": function(chart) {
        // Get the default label list
        const original = Chart.overrides.doughnut.plugins.legend.labels.generateLabels;
        const labelsOriginal = original.call(this, chart);
        // Build an array of colors used in the datasets of the chart
        let datasetColors = chart.data.datasets.map(function (e, index) {
            const dsColors = e.backgroundColor.map((color) => {
                return { color: color, dsIndex: index };
            });
            return dsColors;
        });
        datasetColors = datasetColors.flat();
        // console.log(\`\${datasetColors}, labelsOrig.length=\${labelsOriginal.length}\`);
        // Modify the color and hide state of each label
        labelsOriginal.forEach((label, index) => {
            // Set the correct dataset index for each label
            label.datasetIndex = datasetColors[index].dsIndex;
            // The hidden state must match the dataset's hidden state
            label.hidden = !chart.isDatasetVisible(datasetColors[index].dsIndex);
            // Change the color to match the color specified for the individual data value in the dataset
            label.fillStyle = datasetColors[index].color;
            // Change the title to show both the label (xValue) and the dataset name (dataset label)
            label.text = \`\${label.text} (\${chart.data.datasets[datasetColors[index].dsIndex].label})\`;
        });
        return labelsOriginal;
    }
        },
        "onClick": function(_mouseEvent, legendItem, legend) {
        // toggle the visibility of the dataset from what it currently is
        legend.chart.getDatasetMeta(legendItem.datasetIndex).hidden = legend.chart.isDatasetVisible(legendItem.datasetIndex);
        legend.chart.update();
    },
        "position": "right"
      },
      "tooltip": {
        "callbacks": {
          "title": function(context) {
        const datasetOffsets = [];
        context[0].chart.data.datasets.forEach((_e, index) => {
            let offset = 0;
            for (let i = 0; i < index; i++) {
                offset += context[0].chart.data.datasets[i].data.length;
            }
            datasetOffsets.push(offset);
        });
        const labelIndex = datasetOffsets[context[0].datasetIndex] + context[0].dataIndex;
        return context[0].chart.data.labels[labelIndex];
    }
        }
      }
    }
  }
}
        // 3. Render the chart
        const myChart = new Chart(ctx2, chartProperties);
        </script>
      </canvas>
    </div>
    "
`;

exports[`XYLineChart tests XY Line chart, double set of y values - HTML 1`] = `
"
    <div style="height: 60vh; width: 80vw; margin: auto; background-color: rgba(0,0,0,0)">
      <canvas id="myScatterChart123">

      <script>
        // 1. Get the drawing context from the canvas element
        // const ctx2 = document.getElementById('myScatterChart123').getContext('2d');
        const ctx2 = document.currentScript.parentElement.getContext('2d');
    
        // 2. Set chart properties
        const chartProperties = {
  "type": "scatter",
  "data": {
    "datasets": [
      {
        "data": [
          {
            "x": 1,
            "y": 2
          },
          {
            "x": 2,
            "y": 3
          },
          {
            "x": 3,
            "y": 4
          },
          {
            "x": 4,
            "y": 5
          }
        ],
        "label": "line 1",
        "showLine": true,
        "backgroundColor": "rgba(0,0,0,1)",
        "borderColor": "rgba(0,0,0,1)",
        "borderWidth": 3,
        "pointRadius": 1
      },
      {
        "data": [
          {
            "x": 1,
            "y": 5
          },
          {
            "x": 2,
            "y": 7
          },
          {
            "x": 3,
            "y": 9
          },
          {
            "x": 4,
            "y": 11
          }
        ],
        "label": "line 2 label",
        "showLine": true,
        "backgroundColor": "rgba(0,0,0,1)",
        "borderColor": "rgba(0,0,0,1)",
        "borderWidth": 3,
        "pointRadius": 1
      }
    ]
  },
  "options": {
    "plugins": {
      "title": {
        "display": true,
        "text": "My Chart Title"
      },
      "legend": {
        "display": true,
        "labels": {
          "color": "black"
        },
        "position": "right"
      }
    },
    "scales": {
      "x": {
        "title": {
          "display": true,
          "text": "My X Axis label"
        }
      },
      "y": {
        "title": {
          "display": true,
          "text": "My Y Axis label"
        }
      }
    }
  }
}
        // 3. Render the chart
        const myChart = new Chart(ctx2, chartProperties);
        </script>
      </canvas>
    </div>
    "
`;

