exports[`BarChart tests Simple Bar chart HTML, numeric X, Y values 1`] = `
"
    <div style="height: 60vh; width: 80vw; margin: auto; background-color: rgba(0,0,0,0)">
      <canvas id="myScatterChart123">

      <script>
        // 1. Get the drawing context from the canvas element
        // const ctx2 = document.getElementById('myScatterChart123').getContext('2d');
        const ctx2 = document.currentScript.parentElement.getContext('2d');
    
        // 2. Set chart properties
        const chartProperties = {
  "type": "bar",
  "data": {
    "labels": [
      1,
      2,
      3,
      4
    ],
    "datasets": [
      {
        "data": [
          2,
          3,
          4,
          5
        ],
        "label": "bar 1",
        "showLine": true,
        "backgroundColor": "rgba(0,0,0,1)",
        "borderColor": "rgba(0,0,0,1)",
        "borderWidth": 3
      },
      {
        "data": [
          5,
          7,
          9,
          11
        ],
        "label": "bar 2 label",
        "showLine": true,
        "backgroundColor": "rgba(0,0,0,1)",
        "borderColor": "rgba(0,0,0,1)",
        "borderWidth": 3
      }
    ]
  },
  "options": {
    "plugins": {
      "title": {
        "display": true,
        "text": "Chart Title"
      },
      "legend": {
        "display": true,
        "labels": {
          "color": "black"
        },
        "position": "right"
      }
    },
    "scales": {
      "x": {
        "title": {
          "display": true,
          "text": "X Axis title"
        },
        "stacked": true
      },
      "y": {
        "title": {
          "display": true,
          "text": "Y Axis title"
        },
        "stacked": true
      }
    }
  }
}
        // 3. Render the chart
        const myChart = new Chart(ctx2, chartProperties);
        </script>
      </canvas>
    </div>
    "
`;

